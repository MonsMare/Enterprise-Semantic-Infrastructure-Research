# MinerU Precision Extract API (rotate the key before use)
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL=vlm
MINERU_OCR=false

# OpenAI-compatible Agent Loop / optional metadata enrichment
QWEN_LLM_API_KEY=
# LLM_API_KEY remains accepted for legacy deployments.
LLM_API_KEY=
LLM_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max

# For an on-prem compatible endpoint, replace LLM_BASE_URL with its URL.
